{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["dist", "coverage", "node_modules", "**/node_modules/**", "server/db.json"],
  "plugins": ["typescript", "react", "react-perf", "jsx-a11y", "import", "unicorn", "oxc", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "react/react-in-jsx-scope": "off",
    // Enabled implicitly by the "correctness" category. Side-effect-only imports are
    // intentional for CSS entrypoints (src/main.tsx -> ./index.css) and the Vitest/jest-dom
    // matcher setup (src/test/setup.ts) -- there is nothing to assign. Allowlist those two
    // import sources instead of disabling the rule outright.
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "@testing-library/jest-dom/vitest"] }]
  },
  "overrides": [
    {
      "files": ["src/runner/**/*.ts"],
      "rules": {
        "no-new-func": "off"
      }
    }
  ]
}
