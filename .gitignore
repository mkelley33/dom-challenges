# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage
/.vitest-reports
test-results.xml
# Temporary TypeScript config files generated during testing (e.g., tsconfig.abc123xyz.json)
tsconfig.*.json
!tsconfig.app.json
!tsconfig.node.json

# json-server database (generated by pnpm seed)
/server/db.json

# misc
.DS_Store

# debug
.pnpm-debug.log*

# env files (NEVER commit these)
.env
.env.local
.env.development
.env.production
.env*.local

# typescript
*.tsbuildinfo

# vite build output
/dist

/test-results/

# generated architecture docs — kept locally, never committed
# (regenerate with docs/architectural-diagrams/build-pdf.js)
/docs/architectural-diagrams/

.claude/*
!.claude/settings.json
