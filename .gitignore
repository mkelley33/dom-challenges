# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage
/.vitest-reports
test-results.xml
# artefacts of the Chromium verification pass (`pnpm test:browser`): Vitest writes a screenshot and
# an attachment per failing browser test, and Playwright writes the last two if it is ever run
# directly. All four are per-run diagnostics, never inputs to anything.
/.vitest-attachments
__screenshots__/
/playwright-report/
/test-results/
# Temporary TypeScript config files generated during testing (e.g., tsconfig.abc123xyz.json)
tsconfig.*.json
!tsconfig.app.json
!tsconfig.node.json

# json-server database (generated by pnpm seed)
/server/db.json

# misc
.DS_Store

# debug
.pnpm-debug.log*

# env files (NEVER commit these)
.env
.env.local
.env.development
.env.production
.env*.local

# typescript
*.tsbuildinfo

# vite build output
/dist

/test-results/

# generated architecture docs — kept locally, never committed
# (regenerate with docs/architectural-diagrams/build-pdf.js)
/docs/architectural-diagrams/

.claude/*
!.claude/settings.json
